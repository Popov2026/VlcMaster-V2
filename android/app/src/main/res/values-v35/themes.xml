<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 impose l'affichage « bord à bord » : les écrans avec barre de titre
         (guide, listes, paramètres) gardent la mise en page classique.  L'écran de
         lecture gère lui-même le plein écran. -->
    <style name="Theme.HomeRun" parent="Theme.AppCompat">
        <item name="colorPrimary">#101418</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
